from typing import Optional
from typing import List
from domain.entities import SceneNode

class SceneGraph:
    def __init__(self):
        self.physical_nodes: List[SceneNode] = []

    def add_node(self, node: SceneNode):
        # منع التكرار في الهوية (Identity Collision Prevention)
        for existing in self.physical_nodes:
            if existing.identity.key == node.identity.key:
                raise ValueError(f"CRITICAL: Duplicate Node Identity detected: {node.identity.key}. Graph Integrity Violated!")
        self.physical_nodes.append(node)

    def get_node(self, key: str) -> Optional[SceneNode]:
        for node in self.physical_nodes:
            if node.identity.key == key:
                return node
        return None
